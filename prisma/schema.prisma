/// Backs receta.numero_interno (per-tenant, gaps acceptable). Migration 0011.
model RecetaNumeroContador {
  tenantId    String @id @map("tenant_id") @db.Uuid
  ultimoValor BigInt @default(0) @map("ultimo_valor")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("receta_numero_contador")
  @@schema("fsj")
}

/// Tenant-scoped (M09). Source of truth for the state machine:
/// docs/specs/libro-recetario-y-contralor.md section 1. numero_interno is
/// assigned by fsj.receta_asignar_numero_interno() -- never set by the app.
model Receta {
  id                        String       @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId                  String       @map("tenant_id") @db.Uuid
  numeroInterno             BigInt       @map("numero_interno")
  pacienteId                String       @map("paciente_id") @db.Uuid
  medicoId                  String       @map("medico_id") @db.Uuid
  fechaCreada               DateTime     @default(now()) @map("fecha_creada") @db.Timestamptz(6)
  fechaPrescripcion         DateTime     @map("fecha_prescripcion") @db.Date
  fechaValidaDesde          DateTime?    @map("fecha_valida_desde") @db.Date
  fechaIngreso              DateTime     @default(now()) @map("fecha_ingreso") @db.Timestamptz(6)
  origen                    OrigenReceta
  estado                    EstadoReceta @default(PENDIENTE_PREPARACION)
  archivoAdjuntoUrl         String?      @map("archivo_adjunto_url")
  recetaFisicaRecibida      Boolean      @default(false) @map("receta_fisica_recibida")
  recetaFisicaRecibidaEn    DateTime?    @map("receta_fisica_recibida_en") @db.Timestamptz(6)
  recetaFisicaRecibidaPorId String?      @map("receta_fisica_recibida_por_id") @db.Uuid
  registradaPorId           String       @map("registrada_por_id") @db.Uuid
  motivoAnulacion           String?      @map("motivo_anulacion")
  /// M15, deferred from migration 0011, added in migration 0016. INV-ARC-006: only settable once ENTREGADA/ANULADA + receta_fisica_recibida; frozen once set.
  loteArchivoId             String?      @map("lote_archivo_id") @db.Uuid

  paciente                Paciente     @relation(fields: [pacienteId], references: [id])
  medico                  Medico       @relation(fields: [medicoId], references: [id])
  registradaPor           Usuario      @relation("RecetaRegistradaPor", fields: [registradaPorId], references: [id])
  recetaFisicaRecibidaPor Usuario?     @relation("RecetaFisicaRecibidaPor", fields: [recetaFisicaRecibidaPorId], references: [id])
  items                   ItemReceta[]
  loteArchivo             LoteArchivoRecetas? @relation(fields: [loteArchivoId], references: [id])
  entrega                 Entrega?

  @@unique([tenantId, id])
  @@unique([tenantId, numeroInterno])
  @@map("receta")
  @@schema("fsj")
}

/// Tenant-scoped (M09) / docs/specs/ficha-tecnica.md "ItemReceta". No
/// standalone unidad_medida_id -- see migration 0011 header (spec wins over
/// the plan's M09 table).
model ItemReceta {
  id                     String            @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId               String            @map("tenant_id") @db.Uuid
  recetaId               String            @map("receta_id") @db.Uuid
  descripcion            String?
  formaFarmaceutica      FormaFarmaceutica @map("forma_farmaceutica")
  cantidadUnidades       Int               @map("cantidad_unidades")
  fraccionDosisPorUnidad Decimal           @default(1) @map("fraccion_dosis_por_unidad") @db.Decimal
  cantidadTotal          Decimal?          @map("cantidad_total") @db.Decimal
  unidadTotalId          String?           @map("unidad_total_id") @db.Uuid
  observaciones          String?

  receta      Receta                 @relation(fields: [recetaId], references: [id])
  unidadTotal UnidadMedida?          @relation(fields: [unidadTotalId], references: [id])
  componentes ComponenteItemReceta[]
  fichas      FichaTecnica[]

  @@unique([tenantId, id])
  @@map("item_receta")
  @@schema("fsj")
}

/// Tenant-scoped (M09) / docs/specs/ficha-tecnica.md "ComponenteItemReceta".
/// modo_expresion REPLACES es_cantidad_suficiente (binding decision).
model ComponenteItemReceta {
  id                String        @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  itemRecetaId      String        @map("item_receta_id") @db.Uuid
  drogaId           String        @map("droga_id") @db.Uuid
  cantidad          Decimal?      @db.Decimal
  unidadMedidaId    String        @map("unidad_medida_id") @db.Uuid
  modoExpresion     ModoExpresion @map("modo_expresion")
  esPrincipioActivo Boolean       @default(false) @map("es_principio_activo")
  orden             Int

  itemReceta   ItemReceta   @relation(fields: [itemRecetaId], references: [id])
  droga        Droga        @relation(fields: [drogaId], references: [id])
  unidadMedida UnidadMedida @relation(fields: [unidadMedidaId], references: [id])

  @@unique([tenantId, id])
  @@unique([tenantId, itemRecetaId, orden])
  @@map("componente_item_receta")
  @@schema("fsj")
}

