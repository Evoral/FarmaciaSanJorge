/// Tenant-scoped, fully immutable (M10). Versioned: INV-R05.
model FichaTecnica {
  id            String   @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  itemRecetaId  String   @map("item_receta_id") @db.Uuid
  version       Int
  generadaEn    DateTime @default(now()) @map("generada_en") @db.Timestamptz(6)
  generadaPorId String   @map("generada_por_id") @db.Uuid

  itemReceta    ItemReceta    @relation(fields: [itemRecetaId], references: [id])
  generadaPor   Usuario       @relation(fields: [generadaPorId], references: [id])
  lineas        LineaPesaje[]
  preparaciones Preparacion[]

  @@unique([tenantId, id])
  @@unique([tenantId, itemRecetaId, version])
  @@map("ficha_tecnica")
  @@schema("fsj")
}

/// Tenant-scoped, fully immutable (M10) / docs/specs/ficha-tecnica.md
/// "LineaPesaje". Revised INV-R04 (task binding decision).
model LineaPesaje {
  id              String   @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  fichaTecnicaId  String   @map("ficha_tecnica_id") @db.Uuid
  drogaId         String   @map("droga_id") @db.Uuid
  drogaNombre     String   @map("droga_nombre")
  cantidadTeorica Decimal? @map("cantidad_teorica") @db.Decimal
  excesoAplicado  Decimal  @default(0) @map("exceso_aplicado") @db.Decimal
  cantidadAPesar  Decimal? @map("cantidad_a_pesar") @db.Decimal
  unidadMedidaId  String   @map("unidad_medida_id") @db.Uuid
  esEnraseManual  Boolean  @default(false) @map("es_enrase_manual")
  orden           Int

  fichaTecnica FichaTecnica @relation(fields: [fichaTecnicaId], references: [id])
  droga        Droga        @relation(fields: [drogaId], references: [id])
  unidadMedida UnidadMedida @relation(fields: [unidadMedidaId], references: [id])
  movimientos  MovimientoStock[]
  detalles     DetalleAsiento[]

  @@unique([tenantId, id])
  @@unique([tenantId, fichaTecnicaId, orden])
  @@map("linea_pesaje")
  @@schema("fsj")
}

