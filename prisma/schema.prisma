/// Tenant-scoped (M11). item_receta_id is denormalized/trigger-set -- see
/// migration 0013 header.
model Preparacion {
  id              String            @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  fichaTecnicaId  String            @map("ficha_tecnica_id") @db.Uuid
  itemRecetaId    String            @map("item_receta_id") @db.Uuid
  estado          EstadoPreparacion @default(INICIADA)
  iniciadaEn      DateTime          @default(now()) @map("iniciada_en") @db.Timestamptz(6)
  iniciadaPorId   String            @map("iniciada_por_id") @db.Uuid
  confirmadaEn    DateTime?         @map("confirmada_en") @db.Timestamptz(6)
  preparadaPorId  String?           @map("preparada_por_id") @db.Uuid
  motivoDescarte  String?           @map("motivo_descarte")
  descartadaEn    DateTime?         @map("descartada_en") @db.Timestamptz(6)
  descartadaPorId String?           @map("descartada_por_id") @db.Uuid

  fichaTecnica  FichaTecnica      @relation(fields: [fichaTecnicaId], references: [id])
  iniciadaPor   Usuario           @relation("PreparacionIniciadaPor", fields: [iniciadaPorId], references: [id])
  preparadaPor  Usuario?          @relation("PreparacionPreparadaPor", fields: [preparadaPorId], references: [id])
  descartadaPor Usuario?          @relation("PreparacionDescartadaPor", fields: [descartadaPorId], references: [id])
  movimientos   MovimientoStock[]
  etiqueta      Etiqueta?
  /// At most one SISTEMA asiento per preparacion (partial unique index in the DB -- see AsientoRecetario.preparacionId).
  asientosRecetario AsientoRecetario[]

  @@unique([tenantId, id])
  @@map("preparacion")
  @@schema("fsj")
}

/// Tenant-scoped (M11). DP-28 (content rules) open -- contenido is free text.
model Etiqueta {
  id            String    @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  preparacionId String    @unique @map("preparacion_id") @db.Uuid
  contenido     String
  generadaEn    DateTime  @default(now()) @map("generada_en") @db.Timestamptz(6)
  impresa       Boolean   @default(false)
  impresaEn     DateTime? @map("impresa_en") @db.Timestamptz(6)
  impresaPorId  String?   @map("impresa_por_id") @db.Uuid

  preparacion Preparacion @relation(fields: [preparacionId], references: [id])
  impresaPor  Usuario?    @relation(fields: [impresaPorId], references: [id])

  @@unique([tenantId, id])
  @@unique([tenantId, preparacionId])
  @@map("etiqueta")
  @@schema("fsj")
}

// ============================================================================
// M12 -- libro recetario, contralor (docs/specs/libro-recetario-y-contralor.md)
// M13a -- cierre diario y firma
// M14/M15 -- entrega, archivo de recetas
// FASE 1, points 1.12-1.15. See prisma/migrations/.../0014-0017 for the
// hand-written triggers/functions (hash chain, gapless counter,
// fsj.cierre_diario_firmar, etc.) that make these tables' invariants hold
// -- this file only mirrors columns/relations for type-safe queries.
// ============================================================================

enum TipoLibro {
  RECETARIO
  PSICOTROPICO
  ESTUPEFACIENTE

  @@map("tipo_libro")
  @@schema("fsj")
}

enum OrigenAsiento {
  SISTEMA
  RECTIFICATIVO

  @@map("origen_asiento")
  @@schema("fsj")
}

enum EstadoAsiento {
  VIGENTE
  ANULADO

  @@map("estado_asiento")
  @@schema("fsj")
}

enum TipoMovimientoContralor {
  APERTURA
  INGRESO
  EGRESO
  AJUSTE

  @@map("tipo_movimiento_contralor")
  @@schema("fsj")
}

/// PROPUESTA (DP-34 unresolved) -- plan's own suggested values.
enum ModalidadEntrega {
  RETIRO_PRESENCIAL
  ENVIO

  @@map("modalidad_entrega")
  @@schema("fsj")
}

enum EstadoLoteArchivo {
  EN_ARCHIVO
  PLAZO_CUMPLIDO
  DESTRUCCION_SOLICITADA
  DESTRUCCION_AUTORIZADA
  DESTRUIDO

  @@map("estado_lote_archivo")
  @@schema("fsj")
}

/// M12/M13b minimal model (spec [CONFLICTO], DP-38 open). No folios. At most one OPEN book per (tenant, tipo).
/// numero/fechaRubrica/expedienteRubrica are official rubric data: created NULL, set once (NULL -> value) when actually issued, never invented (DP-38, migration 0018 B3).
model LibroRubricado {
  id                 String    @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  tipo               TipoLibro
  numero             String?
  fechaRubrica       DateTime? @map("fecha_rubrica") @db.Date
  expedienteRubrica  String?   @map("expediente_rubrica")
  fechaCierre        DateTime? @map("fecha_cierre") @db.Date
  registradoPorId    String    @map("registrado_por_id") @db.Uuid
  registradoEn       DateTime  @default(now()) @map("registrado_en") @db.Timestamptz(6)

  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  registradoPor   Usuario              @relation(fields: [registradoPorId], references: [id])
  contador        ContadorCorrelativo?
  asientosRecetario AsientoRecetario[]
  asientosContralor AsientoContralor[]

  @@unique([tenantId, id])
  @@map("libro_rubricado")
  @@schema("fsj")
}

/// DP-31: gapless counter, one row per (tenant, libro). Written ONLY by fsj.contador_correlativo_tomar() -- fsj_app has no direct grant.
model ContadorCorrelativo {
  tenantId    String @map("tenant_id") @db.Uuid
  libroId     String @map("libro_id") @db.Uuid
  ultimoValor BigInt @default(0) @map("ultimo_valor")
  ultimoHash  String @map("ultimo_hash")

  libro LibroRubricado @relation(fields: [libroId], references: [id])

  @@id([tenantId, libroId])
  @@unique([libroId])
  @@map("contador_correlativo")
  @@schema("fsj")
}

/// M12. Fully immutable except cierre_diario_id (once) and estado VIGENTE->ANULADO. Hash chain + numero_correlativo assigned by trigger (migration 0014).
model AsientoRecetario {
  id                  String        @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId            String        @map("tenant_id") @db.Uuid
  libroId             String        @map("libro_id") @db.Uuid
  numeroCorrelativo   BigInt        @map("numero_correlativo")
  fechaAsiento        DateTime      @map("fecha_asiento") @db.Date
  origen              OrigenAsiento
  /// NOT @unique: the DB only has the PARTIAL unique index uq_asiento_recetario_preparacion (tenant_id, preparacion_id) WHERE origen = 'SISTEMA' (migration 0014), which Prisma cannot express.
  preparacionId       String?       @map("preparacion_id") @db.Uuid
  asientoOriginalId   String?       @map("asiento_original_id") @db.Uuid
  pacienteTexto       String        @map("paciente_texto")
  medicoTexto         String        @map("medico_texto")
  formulaTexto        String        @map("formula_texto")
  cierreDiarioId      String?       @map("cierre_diario_id") @db.Uuid
  estado              EstadoAsiento @default(VIGENTE)
  hashIntegridad      String        @map("hash_integridad")
  hashAnterior        String        @map("hash_anterior")
  registradoPorId     String        @map("registrado_por_id") @db.Uuid
  registradoEn        DateTime      @default(now()) @map("registrado_en") @db.Timestamptz(6)

  libro           LibroRubricado     @relation(fields: [libroId], references: [id])
  preparacion     Preparacion?       @relation(fields: [preparacionId], references: [id])
  asientoOriginal AsientoRecetario?  @relation("Rectificativo", fields: [asientoOriginalId], references: [id])
  rectificativos  AsientoRecetario[] @relation("Rectificativo")
  cierreDiario    CierreDiario?      @relation(fields: [cierreDiarioId], references: [id])
  registradoPor   Usuario            @relation(fields: [registradoPorId], references: [id])
  detalles        DetalleAsiento[]
  anulacion       AnulacionAsiento?
  asientosContralor AsientoContralor[]

  @@unique([tenantId, id])
  @@unique([tenantId, libroId, numeroCorrelativo])
  @@map("asiento_recetario")
  @@schema("fsj")
}

/// M12. Immutable. cantidad is cantidad_a_pesar (non-manual) or the real registered quantity (manual-enrase) -- docs/specs/ficha-tecnica.md.
model DetalleAsiento {
  id                  String  @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId            String  @map("tenant_id") @db.Uuid
  asientoRecetarioId  String  @map("asiento_recetario_id") @db.Uuid
  lineaPesajeId       String? @map("linea_pesaje_id") @db.Uuid
  descripcion         String
  cantidad            Decimal @db.Decimal
  unidadTexto         String  @map("unidad_texto")
  orden               Int

  asiento     AsientoRecetario @relation(fields: [asientoRecetarioId], references: [id])
  lineaPesaje LineaPesaje?     @relation(fields: [lineaPesajeId], references: [id])

  @@unique([tenantId, id])
  @@unique([tenantId, asientoRecetarioId, orden])
  @@map("detalle_asiento")
  @@schema("fsj")
}

/// M12, DP-16/DP-16c. Immutable. INSERT validated by trigger (INV-L02/U05); propagates estado=ANULADO onto the asiento (INV-L09).
model AnulacionAsiento {
  id                String   @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  asientoId         String   @unique @map("asiento_id") @db.Uuid
  motivo            String
  autorizadoPorId   String   @map("autorizado_por_id") @db.Uuid
  anuladoPorId      String   @map("anulado_por_id") @db.Uuid
  anuladoEn         DateTime @default(now()) @map("anulado_en") @db.Timestamptz(6)

  asiento       AsientoRecetario @relation(fields: [asientoId], references: [id])
  autorizadoPor Usuario          @relation("AnulacionAutorizadoPor", fields: [autorizadoPorId], references: [id])
  anuladoPor    Usuario          @relation("AnulacionAnuladoPor", fields: [anuladoPorId], references: [id])

  @@unique([tenantId, id])
  @@map("anulacion_asiento")
  @@schema("fsj")
}

/// DP-17, spec section 2: digitized entries from the PHYSICAL book, reference only. Outside the correlativo/hash chain/cierres. Immutable.
model AsientoHistorico {
  id                  String    @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  tipoLibro           TipoLibro @map("tipo_libro")
  numeroAsientoFisico String    @map("numero_asiento_fisico")
  fechaAsiento        DateTime  @map("fecha_asiento") @db.Date
  pacienteTexto       String?   @map("paciente_texto")
  medicoTexto         String?   @map("medico_texto")
  formulaTexto        String    @map("formula_texto")
  observaciones       String?
  digitalizadoPorId   String    @map("digitalizado_por_id") @db.Uuid
  digitalizadoEn      DateTime  @default(now()) @map("digitalizado_en") @db.Timestamptz(6)

  digitalizadoPor Usuario @relation(fields: [digitalizadoPorId], references: [id])

  @@unique([tenantId, id])
  @@map("asiento_historico")
  @@schema("fsj")
}

/// M12, spec section 4. Fully immutable except cierre_diario_id. saldo/correlativo/hash assigned by trigger (migration 0014).
model AsientoContralor {
  id                      String                   @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId                String                   @map("tenant_id") @db.Uuid
  libroId                 String                   @map("libro_id") @db.Uuid
  numeroCorrelativo       BigInt                   @map("numero_correlativo")
  fechaAsiento            DateTime                 @map("fecha_asiento") @db.Date
  tipoMovimiento          TipoMovimientoContralor  @map("tipo_movimiento")
  drogaId                 String                   @map("droga_id") @db.Uuid
  drogaDescripcion        String                   @map("droga_descripcion")
  cantidad                Decimal                  @db.Decimal
  unidadMedidaId          String                   @map("unidad_medida_id") @db.Uuid
  saldoAnterior           Decimal                  @map("saldo_anterior") @db.Decimal
  saldoPosterior          Decimal                  @map("saldo_posterior") @db.Decimal
  movimientoStockId       String?                  @unique @map("movimiento_stock_id") @db.Uuid
  asientoRecetarioId      String?                  @map("asiento_recetario_id") @db.Uuid
  numeroValeAdquisicion   String?                  @map("numero_vale_adquisicion")
  cierreDiarioId          String?                  @map("cierre_diario_id") @db.Uuid
  estado                  EstadoAsiento            @default(VIGENTE)
  hashIntegridad          String                   @map("hash_integridad")
  hashAnterior            String                   @map("hash_anterior")
  registradoPorId         String                   @map("registrado_por_id") @db.Uuid
  registradoEn            DateTime                 @default(now()) @map("registrado_en") @db.Timestamptz(6)

  libro            LibroRubricado    @relation(fields: [libroId], references: [id])
  droga            Droga             @relation(fields: [drogaId], references: [id])
  unidadMedida     UnidadMedida      @relation(fields: [unidadMedidaId], references: [id])
  movimientoStock  MovimientoStock?  @relation(fields: [movimientoStockId], references: [id])
  asientoRecetario AsientoRecetario? @relation(fields: [asientoRecetarioId], references: [id])
  cierreDiario     CierreDiario?     @relation(fields: [cierreDiarioId], references: [id])
  registradoPor    Usuario           @relation(fields: [registradoPorId], references: [id])

  @@unique([tenantId, id])
  @@unique([tenantId, libroId, numeroCorrelativo])
  @@map("asiento_contralor")
  @@schema("fsj")
}

/// M13a. Immutable except fecha_impresion/impreso_por_id. Rows created EXCLUSIVELY by fsj.cierre_diario_firmar() (migration 0015) -- fsj_app has no direct INSERT grant.
model CierreDiario {
  id                  String    @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  fecha               DateTime  @db.Date
  directorTecnicoId   String    @map("director_tecnico_id") @db.Uuid
  designacionId       String    @map("designacion_id") @db.Uuid
  matriculaDt         String    @map("matricula_dt")
  cantidadAsientos    Int       @map("cantidad_asientos")
  hashLote            String    @map("hash_lote")
  selloTiempo         DateTime  @default(now()) @map("sello_tiempo") @db.Timestamptz(6)
  mecanismoFirma      String    @default("CREDENCIALES_DT") @map("mecanismo_firma")
  versionFormato      Int       @default(1) @map("version_formato")
  fechaImpresion      DateTime? @map("fecha_impresion") @db.Timestamptz(6)
  impresoPorId        String?   @map("impreso_por_id") @db.Uuid
  fechaFirma          DateTime  @default(now()) @map("fecha_firma") @db.Timestamptz(6)
  fueraDeTermino      Boolean   @map("fuera_de_termino")
  motivoDemora        String?   @map("motivo_demora")
  motivoDemoraDetalle String?   @map("motivo_demora_detalle")

  directorTecnico  Usuario                     @relation("CierreDirectorTecnico", fields: [directorTecnicoId], references: [id])
  designacion      DesignacionDirectorTecnico  @relation(fields: [designacionId], references: [id])
  impresoPor       Usuario?                    @relation("CierreImpresoPor", fields: [impresoPorId], references: [id])
  asientosRecetario AsientoRecetario[]
  asientosContralor AsientoContralor[]

  @@unique([tenantId, id])
  @@unique([tenantId, fecha])
  @@map("cierre_diario")
  @@schema("fsj")
}

/// M14. One row per receta. Mutable (firma_recibida/firma_recibida_en only).
model Entrega {
  id                  String           @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId            String           @map("tenant_id") @db.Uuid
  recetaId            String           @unique @map("receta_id") @db.Uuid
  modalidad           ModalidadEntrega
  entregadaPorId      String           @map("entregada_por_id") @db.Uuid
  entregadaEn         DateTime         @default(now()) @map("entregada_en") @db.Timestamptz(6)
  firmaRecibida       Boolean          @default(false) @map("firma_recibida")
  firmaRecibidaEn     DateTime?        @map("firma_recibida_en") @db.Timestamptz(6)
  fechaArchivoReceta  DateTime?        @map("fecha_archivo_receta") @db.Date

  receta        Receta  @relation(fields: [recetaId], references: [id])
  entregadaPor  Usuario @relation(fields: [entregadaPorId], references: [id])

  @@unique([tenantId, id])
  @@map("entrega")
  @@schema("fsj")
}

/// M15. Linear state machine EN_ARCHIVO -> ... -> DESTRUIDO (trigger-enforced). Immutable once DESTRUIDO (INV-D05).
model LoteArchivoRecetas {
  id                      String            @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId                String            @map("tenant_id") @db.Uuid
  periodoDesde            DateTime          @map("periodo_desde") @db.Date
  periodoHasta            DateTime          @map("periodo_hasta") @db.Date
  ubicacion               String
  incluyeControladas      Boolean           @default(false) @map("incluye_controladas")
  estado                  EstadoLoteArchivo @default(EN_ARCHIVO)
  expedienteAutorizacion  String?           @map("expediente_autorizacion")
  fechaAutorizacion       DateTime?         @map("fecha_autorizacion") @db.Date
  fechaDestruccion        DateTime?         @map("fecha_destruccion") @db.Date
  registradoPorId         String            @map("registrado_por_id") @db.Uuid
  registradoEn            DateTime          @default(now()) @map("registrado_en") @db.Timestamptz(6)

  registradoPor Usuario  @relation(fields: [registradoPorId], references: [id])
  recetas       Receta[]

  @@unique([tenantId, id])
  @@map("lote_archivo_recetas")
  @@schema("fsj")
}
