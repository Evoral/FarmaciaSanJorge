// Prisma schema for Farmacia San Jose.
//
// FASE 1 (points 1.1-1.5): tenancy/parametros, usuarios/roles/permisos,
// registro_auditoria, credenciales/sesiones, designacion_director_tecnico.
// Every model lives in the dedicated `fsj` Postgres schema (never
// `public`), per docs/architecture.md.
//
// SOURCE OF TRUTH: the hand-written SQL under prisma/migrations/ (triggers,
// RLS policies, grants, the EXCLUDE constraint, deferred constraint
// triggers -- none of which Prisma's schema language can express). This
// file is kept IN SYNC with those migrations for type-safe queries, but a
// migration.sql diff always wins over this file if they ever disagree.

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Both `url` and `directUrl` live in prisma.config.ts (see that file).
  schemas    = ["fsj"]
  extensions = [pgcrypto(schema: "extensions"), citext(schema: "extensions"), btreeGist(map: "btree_gist", schema: "extensions")]
}

// ============================================================================
// Enums
// ============================================================================

/// DP-01 RESUELTA.
enum EstadoUsuario {
  PENDIENTE_ACTIVACION
  ACTIVO
  SUSPENDIDO
  BAJA

  @@map("estado_usuario")
  @@schema("fsj")
}

enum ParametroTipo {
  TEXTO
  NUMERO
  BOOLEANO

  @@map("parametro_tipo")
  @@schema("fsj")
}

enum TipoAccion {
  CREAR
  MODIFICAR
  BAJA
  REACTIVAR
  ANULAR
  AUTORIZAR
  FIRMAR
  CONFIRMAR
  DESCARTAR
  CAMBIAR_ESTADO
  ASIGNAR_ROL
  QUITAR_ROL
  SUSPENDER
  RESTABLECER_CREDENCIAL
  ACTIVAR_CUENTA
  LOGIN_FALLIDO_BLOQUEO
  CORREGIR_FOLIO
  INUTILIZAR_FOJAS
  DESTRUIR
  IMPRIMIR_CIERRE

  @@map("tipo_accion")
  @@schema("fsj")
}

enum MotivoEmisionCredencial {
  ALTA
  RESTABLECIMIENTO

  @@map("motivo_emision_credencial")
  @@schema("fsj")
}

enum CaracterDesignacionDt {
  TITULAR
  SUPLENTE

  @@map("caracter_designacion_dt")
  @@schema("fsj")
}

/// DP-07 PARCIALMENTE RESUELTA: only the unambiguous magnitudes are
/// modeled. See migration 0006 header.
enum TipoMagnitud {
  MASA
  VOLUMEN
  UNIDADES

  @@map("tipo_magnitud")
  @@schema("fsj")
}

enum TipoControl {
  NINGUNO
  PSICOTROPICO
  ESTUPEFACIENTE

  @@map("tipo_control")
  @@schema("fsj")
}

enum TipoMovimiento {
  INGRESO_COMPRA
  EGRESO_PREPARACION
  AJUSTE

  @@map("tipo_movimiento")
  @@schema("fsj")
}

enum MotivoAjuste {
  ROTURA
  DERRAME
  VENCIMIENTO
  PREPARACION_DESCARTADA
  DIFERENCIA_ARQUEO

  @@map("motivo_ajuste")
  @@schema("fsj")
}

/// M09. PRESENCIAL|DIGITAL_PDF|DIGITAL_FOTO.
enum OrigenReceta {
  PRESENCIAL
  DIGITAL_PDF
  DIGITAL_FOTO

  @@map("origen_receta")
  @@schema("fsj")
}

/// M09. docs/specs/libro-recetario-y-contralor.md section 1 (state machine).
enum EstadoReceta {
  PENDIENTE_PREPARACION
  EN_PREPARACION
  PREPARADA
  LISTA_PARA_RETIRAR
  ENVIADA_PEND_FIRMA
  ENTREGADA
  ANULADA

  @@map("estado_receta")
  @@schema("fsj")
}

/// PROPUESTA (migration 0011 header) -- CAPSULA/COMPRIMIDO are special-cased
/// by the ficha calculator (modules/elaboracion/domain/calcular-ficha-tecnica.ts).
enum FormaFarmaceutica {
  CAPSULA
  COMPRIMIDO
  CREMA
  GEL
  UNGUENTO
  JARABE
  SOLUCION
  SUSPENSION
  POLVO
  OVULO
  SUPOSITORIO
  LOCION

  @@map("forma_farmaceutica")
  @@schema("fsj")
}

/// docs/specs/ficha-tecnica.md. REPLACES the diagram's es_cantidad_suficiente boolean.
enum ModoExpresion {
  TOTAL
  POR_DOSIS
  CS
  CSP

  @@map("modo_expresion")
  @@schema("fsj")
}

/// M11.
enum EstadoPreparacion {
  INICIADA
  CONFIRMADA
  DESCARTADA

  @@map("estado_preparacion")
  @@schema("fsj")
}

// ============================================================================
// M00 -- tenancy
// ============================================================================

/// Global table (M00): one row per pharmacy tenant. No tenant_id, no RLS.
model Tenant {
  id                String    @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  razonSocial       String    @map("razon_social")
  nombreFantasia    String?   @map("nombre_fantasia")
  cuit              String    @unique
  domicilio         String?
  matriculaFarmacia String?   @map("matricula_farmacia")
  zonaHoraria       String    @default("America/Argentina/Mendoza") @map("zona_horaria")
  fechaBaja         DateTime? @map("fecha_baja") @db.Timestamptz(6)
  creadoEn          DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  /// M12/spec section 4 (DP-33). NULL = contralor libros kept by hand. INV-L17: never changes once set (migration 0014).
  fechaActivacionContralor DateTime? @map("fecha_activacion_contralor") @db.Timestamptz(6)

  parametros           Parametro[]
  usuarios             Usuario[]
  recetaNumeroContador RecetaNumeroContador?
  librosRubricados     LibroRubricado[]

  @@map("tenant")
  @@schema("fsj")
}

/// Tenant-scoped typed key/value parameters (M00). PK (tenant_id, clave).
model Parametro {
  tenantId      String        @map("tenant_id") @db.Uuid
  clave         String
  tipo          ParametroTipo
  valor         String
  descripcion   String?
  actualizadoEn DateTime      @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, clave])
  @@map("parametro")
  @@schema("fsj")
}

// ============================================================================
// M03 -- usuarios, roles, permisos
// ============================================================================

/// Global catalog (M03): the 5 assignable roles + the internal SISTEMA role
/// (see migration 0002 comment for why SISTEMA has a row here).
model Rol {
  id          String  @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  codigo      String  @unique
  nombre      String
  descripcion String?

  permisos     RolPermiso[]
  asignaciones UsuarioRol[]

  @@map("rol")
  @@schema("fsj")
}

/// Global catalog (M03): permission codes.
model Permiso {
  id          String  @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  codigo      String  @unique
  descripcion String?

  roles RolPermiso[]

  @@map("permiso")
  @@schema("fsj")
}

/// Global catalog (M03): role -> permission matrix.
model RolPermiso {
  rolId     String @map("rol_id") @db.Uuid
  permisoId String @map("permiso_id") @db.Uuid

  rol     Rol     @relation(fields: [rolId], references: [id])
  permiso Permiso @relation(fields: [permisoId], references: [id])

  @@id([rolId, permisoId])
  @@map("rol_permiso")
  @@schema("fsj")
}

/// Tenant-scoped user account (M03). DP-40: email is globally unique. DP-41: one tenant per user.
model Usuario {
  id               String        @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  /// citext (case-insensitive), globally unique across ALL tenants -- DP-40.
  email            String        @unique @db.Citext
  nombre           String
  apellido         String
  dni              String
  estado           EstadoUsuario @default(PENDIENTE_ACTIVACION)
  passwordHash     String?       @map("password_hash")
  esTecnico        Boolean       @default(false) @map("es_tecnico")
  intentosFallidos Int           @default(0) @map("intentos_fallidos")
  bloqueadoHasta   DateTime?     @map("bloqueado_hasta") @db.Timestamptz(6)
  creadoPorId      String        @map("creado_por_id") @db.Uuid
  creadoEn         DateTime      @default(now()) @map("creado_en") @db.Timestamptz(6)
  ultimoAcceso     DateTime?     @map("ultimo_acceso") @db.Timestamptz(6)
  numeroMatricula  String?       @map("numero_matricula")
  fechaBaja        DateTime?     @map("fecha_baja") @db.Timestamptz(6)
  motivoBaja       String?       @map("motivo_baja")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  // Self-referencing composite FK (tenant_id, creado_por_id) -> (tenant_id, id).
  // Prisma cannot express a *composite* self-relation with a clean field
  // name here without an extra scalar; represented for read/type purposes
  // as a plain scalar (`creadoPorId`) -- see migration 0002 for the actual
  // FK, which Prisma will not manage (hand-written SQL is the source of truth).

  rolesAsignados                UsuarioRol[]                 @relation("UsuarioRolUsuario")
  rolesAsignadosPorMi           UsuarioRol[]                 @relation("UsuarioRolAsignadoPor")
  historialEstados              UsuarioEstadoHistorial[]     @relation("HistorialUsuario")
  historialEstadosCambiadoPorMi UsuarioEstadoHistorial[]     @relation("HistorialCambiadoPor")
  registrosAuditoria            RegistroAuditoria[]          @relation("AuditoriaUsuario")
  registrosAutorizadosPorMi     RegistroAuditoria[]          @relation("AuditoriaAutorizadoPor")
  credencialesActivacion        CredencialActivacion[]       @relation("CredencialUsuario")
  credencialesEmitidasPorMi     CredencialActivacion[]       @relation("CredencialEmitidaPor")
  sesiones                      Sesion[]
  designacionesDt               DesignacionDirectorTecnico[] @relation("DesignacionUsuario")
  designacionesRegistradasPorMi DesignacionDirectorTecnico[] @relation("DesignacionRegistradoPor")
  movimientosRegistrados        MovimientoStock[]            @relation("MovimientoRegistradoPor")
  movimientosAutorizadosPorMi   MovimientoStock[]            @relation("MovimientoAutorizadoPor")
  recetasRegistradas            Receta[]                     @relation("RecetaRegistradaPor")
  recetasFisicaRecibidaPorMi    Receta[]                     @relation("RecetaFisicaRecibidaPor")
  fichasTecnicasGeneradas       FichaTecnica[]
  preparacionesIniciadas        Preparacion[]                @relation("PreparacionIniciadaPor")
  preparacionesPreparadas       Preparacion[]                @relation("PreparacionPreparadaPor")
  preparacionesDescartadas      Preparacion[]                @relation("PreparacionDescartadaPor")
  etiquetasImpresas             Etiqueta[]
  librosRubricadosRegistrados   LibroRubricado[]
  asientosRecetarioRegistrados  AsientoRecetario[]
  anulacionesAutorizadas        AnulacionAsiento[]           @relation("AnulacionAutorizadoPor")
  anulacionesRealizadas         AnulacionAsiento[]           @relation("AnulacionAnuladoPor")
  asientosHistoricosDigitalizados AsientoHistorico[]
  asientosContralorRegistrados  AsientoContralor[]
  cierresFirmados               CierreDiario[]               @relation("CierreDirectorTecnico")
  cierresImpresos               CierreDiario[]                @relation("CierreImpresoPor")
  entregasRegistradas           Entrega[]
  lotesArchivoRegistrados       LoteArchivoRecetas[]

  @@unique([tenantId, id])
  @@unique([tenantId, dni])
  @@map("usuario")
  @@schema("fsj")
}

/// Tenant-scoped role assignment (M03). INV-U02 (>=1 role) is enforced by a
/// deferred constraint trigger -- see migration 0002.
model UsuarioRol {
  id            String   @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  usuarioId     String   @map("usuario_id") @db.Uuid
  rolId         String   @map("rol_id") @db.Uuid
  asignadoPorId String   @map("asignado_por_id") @db.Uuid
  asignadoEn    DateTime @default(now()) @map("asignado_en") @db.Timestamptz(6)

  usuario     Usuario @relation("UsuarioRolUsuario", fields: [usuarioId], references: [id])
  asignadoPor Usuario @relation("UsuarioRolAsignadoPor", fields: [asignadoPorId], references: [id])
  rol         Rol     @relation(fields: [rolId], references: [id])

  @@unique([tenantId, id])
  @@unique([tenantId, usuarioId, rolId])
  @@map("usuario_rol")
  @@schema("fsj")
}

/// Tenant-scoped, append-only history of usuario.estado changes (M03).
model UsuarioEstadoHistorial {
  id             String         @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  usuarioId      String         @map("usuario_id") @db.Uuid
  estadoAnterior EstadoUsuario? @map("estado_anterior")
  estadoNuevo    EstadoUsuario  @map("estado_nuevo")
  motivo         String?
  cambiadoPorId  String         @map("cambiado_por_id") @db.Uuid
  cambiadoEn     DateTime       @default(now()) @map("cambiado_en") @db.Timestamptz(6)

  usuario     Usuario @relation("HistorialUsuario", fields: [usuarioId], references: [id])
  cambiadoPor Usuario @relation("HistorialCambiadoPor", fields: [cambiadoPorId], references: [id])

  @@unique([tenantId, id])
  @@map("usuario_estado_historial")
  @@schema("fsj")
}

// ============================================================================
// M01 -- auditoria
// ============================================================================

/// Tenant-scoped, fully immutable audit log (M01). INV-A02/A03.
model RegistroAuditoria {
  id              String     @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  usuarioId       String     @map("usuario_id") @db.Uuid
  entidad         String
  entidadId       String     @map("entidad_id") @db.Uuid
  accion          TipoAccion
  valorAnterior   Json?      @map("valor_anterior") @db.JsonB
  valorNuevo      Json?      @map("valor_nuevo") @db.JsonB
  motivo          String?
  autorizadoPorId String?    @map("autorizado_por_id") @db.Uuid
  contexto        Json?      @db.JsonB
  ip              String?    @db.Inet
  ocurridoEn      DateTime   @default(now()) @map("ocurrido_en") @db.Timestamptz(6)

  usuario       Usuario  @relation("AuditoriaUsuario", fields: [usuarioId], references: [id])
  autorizadoPor Usuario? @relation("AuditoriaAutorizadoPor", fields: [autorizadoPorId], references: [id])

  @@unique([tenantId, id])
  @@map("registro_auditoria")
  @@schema("fsj")
}

// ============================================================================
// M02 -- credenciales y sesiones
// ============================================================================

/// Tenant-scoped, one-use activation/reset credential (M02).
model CredencialActivacion {
  id            String                  @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId      String                  @map("tenant_id") @db.Uuid
  usuarioId     String                  @map("usuario_id") @db.Uuid
  tokenHash     String                  @unique @map("token_hash")
  emitidaPorId  String                  @map("emitida_por_id") @db.Uuid
  emitidaEn     DateTime                @default(now()) @map("emitida_en") @db.Timestamptz(6)
  venceEn       DateTime                @map("vence_en") @db.Timestamptz(6)
  usadaEn       DateTime?               @map("usada_en") @db.Timestamptz(6)
  revocadaEn    DateTime?               @map("revocada_en") @db.Timestamptz(6)
  motivoEmision MotivoEmisionCredencial @map("motivo_emision")

  usuario    Usuario @relation("CredencialUsuario", fields: [usuarioId], references: [id])
  emitidaPor Usuario @relation("CredencialEmitidaPor", fields: [emitidaPorId], references: [id])

  @@unique([tenantId, id])
  @@map("credencial_activacion")
  @@schema("fsj")
}

/// Tenant-scoped opaque session (M02).
model Sesion {
  id              String    @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  usuarioId       String    @map("usuario_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  creadaEn        DateTime  @default(now()) @map("creada_en") @db.Timestamptz(6)
  ultimoUsoEn     DateTime  @default(now()) @map("ultimo_uso_en") @db.Timestamptz(6)
  expiraEn        DateTime  @map("expira_en") @db.Timestamptz(6)
  revocadaEn      DateTime? @map("revocada_en") @db.Timestamptz(6)
  ip              String?   @db.Inet
  userAgent       String?   @map("user_agent")
  reautenticadaEn DateTime? @map("reautenticada_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([tenantId, id])
  @@map("sesion")
  @@schema("fsj")
}

// ============================================================================
// M04 -- designacion de director tecnico
// ============================================================================

/// Tenant-scoped DT designation (M04). INV-DT-001..003.
model DesignacionDirectorTecnico {
  id                    String                @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId              String                @map("tenant_id") @db.Uuid
  usuarioId             String                @map("usuario_id") @db.Uuid
  caracter              CaracterDesignacionDt
  matricula             String
  expedienteDesignacion String?               @map("expediente_designacion")
  vigenteDesde          DateTime              @map("vigente_desde") @db.Date
  vigenteHasta          DateTime?             @map("vigente_hasta") @db.Date
  motivoCese            String?               @map("motivo_cese")
  registradoPorId       String                @map("registrado_por_id") @db.Uuid
  registradoEn          DateTime              @default(now()) @map("registrado_en") @db.Timestamptz(6)

  usuario       Usuario @relation("DesignacionUsuario", fields: [usuarioId], references: [id])
  registradoPor Usuario @relation("DesignacionRegistradoPor", fields: [registradoPorId], references: [id])
  cierres       CierreDiario[]

  @@unique([tenantId, id])
  @@map("designacion_director_tecnico")
  @@schema("fsj")
}

// ============================================================================
// M05 -- unidades de medida
// ============================================================================

/// GLOBAL catalog (M05, DP-39 RESUELTA): no tenant_id, no RLS, shared by
/// every tenant. See migration 0006 for INV-M01..M04 and fsj.convertir().
model UnidadMedida {
  id           String       @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  codigo       String       @unique
  nombre       String
  simbolo      String
  tipoMagnitud TipoMagnitud @map("tipo_magnitud")
  factorABase  Decimal      @map("factor_a_base") @db.Decimal(20, 10)
  esBase       Boolean      @default(false) @map("es_base")
  /// INV-M04 usage marker -- written only by fsj.unidad_medida_marcar_usada().
  usada        Boolean      @default(false)
  fechaBaja    DateTime?    @map("fecha_baja") @db.Timestamptz(6)
  motivoBaja   String?      @map("motivo_baja")

  drogas                Droga[]
  itemsRecetaTotal      ItemReceta[]
  componentesItemReceta ComponenteItemReceta[]
  lineasPesaje          LineaPesaje[]
  asientosContralor     AsientoContralor[]

  @@map("unidad_medida")
  @@schema("fsj")
}

// ============================================================================
// M06 -- drogas, proveedores, medicos, pacientes
// ============================================================================

/// Tenant-scoped (M06). No stock column (INV-S01) -- see fsj.v_stock_droga
/// (migration 0008). INV-DRG-001 (unidad_base_id/tipo_control immutable
/// once used) is NOT enforced -- DP-12 unresolved.
model Droga {
  id           String      @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  nombre       String      @db.Citext
  unidadBaseId String      @map("unidad_base_id") @db.Uuid
  /// PROPUESTA (DP-06b unresolved) -- not consumed by fsj.convertir().
  densidad     Decimal?    @db.Decimal
  esControlada Boolean     @default(false) @map("es_controlada")
  tipoControl  TipoControl @default(NINGUNO) @map("tipo_control")
  stockMinimo  Decimal     @default(0) @map("stock_minimo") @db.Decimal
  fechaBaja    DateTime?   @map("fecha_baja") @db.Timestamptz(6)
  motivoBaja   String?     @map("motivo_baja")

  // unidad_base_id references the GLOBAL unidad_medida catalog directly
  // (not a composite FK -- unidad_medida has no tenant_id, DP-39).
  unidadBase            UnidadMedida           @relation(fields: [unidadBaseId], references: [id])
  partidas              Partida[]
  componentesItemReceta ComponenteItemReceta[]
  lineasPesaje          LineaPesaje[]
  asientosContralor     AsientoContralor[]

  @@unique([tenantId, id])
  @@map("droga")
  @@schema("fsj")
}

/// Tenant-scoped (M06). cuit format only -- check-digit validation is
/// application-layer (zod, FASE 4).
model Proveedor {
  id          String    @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  razonSocial String    @map("razon_social")
  cuit        String
  fechaBaja   DateTime? @map("fecha_baja") @db.Timestamptz(6)

  partidas Partida[]

  @@unique([tenantId, id])
  @@unique([tenantId, cuit])
  @@map("proveedor")
  @@schema("fsj")
}

/// Tenant-scoped (M06). matricula uniqueness scoped to active rows per
/// tenant -- DP-23 (jurisdiction?) unresolved.
model Medico {
  id                  String    @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  nombre              String
  apellido            String
  matricula           String
  especialidad        String?
  telefono            String?
  direccionRegistrada String?   @map("direccion_registrada")
  fechaBaja           DateTime? @map("fecha_baja") @db.Timestamptz(6)

  recetas Receta[]

  @@unique([tenantId, id])
  @@map("medico")
  @@schema("fsj")
}

/// Tenant-scoped (M06). Health-adjacent data (DP-24) -- access restriction
/// and log redaction are [APP] concerns, not enforced in DDL.
model Paciente {
  id              String    @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  cuil            String?   @db.VarChar(11)
  dni             String?   @db.VarChar(8)
  nombre          String
  apellido        String
  telefono        String?
  email           String?
  fechaNacimiento DateTime? @map("fecha_nacimiento") @db.Date
  nroCredencial   String?   @map("nro_credencial")
  sexo            String?
  fechaBaja       DateTime? @map("fecha_baja") @db.Timestamptz(6)

  recetas Receta[]

  @@unique([tenantId, id])
  @@map("paciente")
  @@schema("fsj")
}

// ============================================================================
// M07 -- stock y partidas
// ============================================================================

/// Tenant-scoped (M07). cantidad_disponible is written ONLY by
/// fsj.movimiento_stock_aplicar() (INV-S01/S04) -- see migration 0008.
model Partida {
  id                      String    @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  drogaId                 String    @map("droga_id") @db.Uuid
  proveedorId             String    @map("proveedor_id") @db.Uuid
  lote                    String
  costoUnitario           Decimal   @map("costo_unitario") @db.Decimal
  cantidadInicial         Decimal   @map("cantidad_inicial") @db.Decimal
  /// INV-S01/S04: read-only from the app's perspective -- see migration 0008.
  cantidadDisponible      Decimal   @default(0) @map("cantidad_disponible") @db.Decimal
  fechaIngreso            DateTime  @default(now()) @map("fecha_ingreso") @db.Timestamptz(6)
  fechaVencimiento        DateTime  @map("fecha_vencimiento") @db.Date
  /// INV-S16/S17: read-only from the app's perspective -- see migration 0008.
  fechaApertura           DateTime? @map("fecha_apertura") @db.Timestamptz(6)
  motivoAperturaAdicional String?   @map("motivo_apertura_adicional")

  droga       Droga             @relation(fields: [drogaId], references: [id])
  proveedor   Proveedor         @relation(fields: [proveedorId], references: [id])
  movimientos MovimientoStock[]

  @@unique([tenantId, id])
  @@unique([tenantId, drogaId, proveedorId, lote])
  @@map("partida")
  @@schema("fsj")
}

/// Tenant-scoped, fully immutable (M07, INV-S06). DP-21b RESUELTA: AJUSTE
/// always subtracts -- see fsj.movimiento_stock_aplicar() (migration 0008).
model MovimientoStock {
  id              String         @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  partidaId       String         @map("partida_id") @db.Uuid
  tipo            TipoMovimiento
  cantidad        Decimal        @db.Decimal
  /// No FK yet -- fsj.preparacion arrives in migration 1.11.
  preparacionId   String?        @map("preparacion_id") @db.Uuid
  motivoAjuste    MotivoAjuste?  @map("motivo_ajuste")
  observacion     String?
  registradoPorId String         @map("registrado_por_id") @db.Uuid
  autorizadoPorId String?        @map("autorizado_por_id") @db.Uuid
  desvioPropuesta Boolean        @default(false) @map("desvio_propuesta")
  registradoEn    DateTime       @default(now()) @map("registrado_en") @db.Timestamptz(6)
  /// M12, migration 0014. Required for INGRESO_COMPRA of a controlled droga once the tenant's contralor is active (INV-L16).
  numeroValeAdquisicion String? @map("numero_vale_adquisicion")
  /// S12/S13/S19/S20 (revised), migration 0014. Required for EGRESO_PREPARACION.
  lineaPesajeId   String?        @map("linea_pesaje_id") @db.Uuid

  partida       Partida      @relation(fields: [partidaId], references: [id])
  registradoPor Usuario      @relation("MovimientoRegistradoPor", fields: [registradoPorId], references: [id])
  autorizadoPor Usuario?     @relation("MovimientoAutorizadoPor", fields: [autorizadoPorId], references: [id])
  preparacion   Preparacion? @relation(fields: [preparacionId], references: [id])
  lineaPesaje   LineaPesaje? @relation(fields: [lineaPesajeId], references: [id])
  asientoContralor AsientoContralor?

  @@unique([tenantId, id])
  @@map("movimiento_stock")
  @@schema("fsj")
}

