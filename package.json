{
  "name": "farmacia-san-jorge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:desarrollo": "tsx scripts/dev.ts .env.desarrollo",
    "dev:prod": "tsx scripts/dev.ts .env.prod",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "specs:validate": "openspec validate --specs --strict --no-interactive",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "db:bootstrap": "tsx scripts/db-bootstrap.ts",
    "db:create-tenant": "tsx scripts/create-tenant.ts",
    "db:superadmin": "tsx scripts/superadmin.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pino": "^10.4.0",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.16.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "pino-pretty": "^13.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
